{
  "manifest_version": 3,
  "name": "LensQuery Web Connector",
  "version": "0.6.0",
  "description": "Analyze selected text, images, videos, or page context with LensQuery.",
  "key": "",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "action": {
    "default_title": "使用 LensQuery 分析当前网址"
  },
  "omnibox": {
    "keyword": "lq"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["page-context.js", "custom-context-menu.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/16.png", "icons/32.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "ask-lensquery": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Point at something on this page"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
