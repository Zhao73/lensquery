{
  "name": "lensquery",
  "main": "electron/main.js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc -b && vite build",
    "build:sidecar": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "build:finder:macos": "node scripts/build-finder-extension.mjs",
    "build:electron": "npm run build && npm run build:sidecar && npm run build:finder:macos && electron-builder --dir",
    "dist:electron:mac": "npm run build && npm run build:sidecar && npm run build:finder:macos && electron-builder --mac dmg",
    "dist:electron:win": "npm run build && npm run build:sidecar && electron-builder --win nsis",
    "lint": "oxlint src electron browser-extension scripts/dev-electron.mjs vite.config.ts --deny-warnings",
    "preview": "vite preview",
    "tauri": "tauri",
    "install:macos": "bash scripts/install-macos.sh",
    "install:electron:macos": "bash scripts/install-electron-macos.sh",
    "install:browser:macos": "bash browser-extension/native-host/install-macos.sh filelbpgenppllkeeofajalcgbnifgmi '/Applications/LensQuery.app'",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "description": "Ask AI about anything visible on your desktop or inside a local file.",
  "author": "LensQuery contributors",
  "license": "MIT"
}
